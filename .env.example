# Copy to .env (never commit it): cp .env.example .env

# ───────────── required ─────────────
OPEN_ROUTER_API_KEY=
# Protects the admin endpoints /index and /search. Any long random string:
#   openssl rand -hex 32
ADMIN_API_KEY=

# ───────────── the site ─────────────
HTTP_PORT=8080

# ───────────── limits per visitor ─────────────
MAX_QUESTIONS_PER_USER=5
MAX_CHATS_PER_USER=2
# a safety net against visitors who clear their browser storage to get a new identity
MAX_QUESTIONS_PER_IP=15

# ───────────── client IP detection ─────────────
# How many reverse proxies append to X-Forwarded-For before a request reaches the backend:
#   1 = only the nginx of this compose file (the site is reachable directly)
#   2 = nginx + one more proxy in front (Caddy, Traefik, a cloud load balancer, ...)
# With a wrong value all visitors look like one IP and share the MAX_QUESTIONS_PER_IP budget.
TRUSTED_PROXY_COUNT=1

# ───────────── only for the sync job ─────────────
# The folder of the Obsidian vault on THIS machine (mounted read-only into the job)
OBSIDIAN_VAULT_PATH=/Users/you/Documents/Obsidian Vault

# ───────────── rarely needed ─────────────
# CORS_ORIGINS=["https://example.com"]   # only if the API is served from another origin
# VITE_API_BASE=https://api.example.com/api/v1   # build-time; default: /api/v1 (same origin)
# VISION_MODEL=openai/gpt-4o-mini
