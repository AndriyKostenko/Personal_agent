# Copy to .env (never commit it): cp .env.example .env

# ───────────── required ─────────────
OPEN_ROUTER_API_KEY=
# Protects the admin endpoints /index and /search. Any long random string:
#   openssl rand -hex 32
ADMIN_API_KEY=

# ───────────── the site ─────────────
# The domain whose DNS A record points at this machine; Caddy gets a certificate for it.
# No domain yet? Use <ip with dashes>.nip.io, e.g. 34-12-56-78.nip.io
DOMAIN=

# ───────────── limits per visitor ─────────────
MAX_QUESTIONS_PER_USER=10
MAX_CHATS_PER_USER=1
# a safety net against visitors who clear their browser storage to get a new identity
MAX_QUESTIONS_PER_IP=15

# ───────────── booking a call via Google Calendar (optional) ─────────────
# Leave the three GOOGLE_* values empty to disable booking. To get them:
#   1. Google Cloud: enable the Calendar API, create an OAuth client of type "Desktop app"
#   2. put GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET below
#   3. run once on your computer (from backend/): python utils/google_consent.py
#      and paste the printed GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# BOOKING_TIMEZONE=Etc/GMT+6      # IANA name; the timezone of the working hours below
# WORK_START_HOUR=10
# WORK_END_HOUR=18
# SLOT_MINUTES=30
# BUFFER_MINUTES=10               # free gap required around every existing event
# MIN_NOTICE_HOURS=24
# BOOKING_HORIZON_DAYS=30
# MAX_BOOKINGS_PER_USER=1         # per visitor
# MAX_BOOKINGS_PER_IP=2
# MAX_BOOKINGS_PER_DAY=10         # all visitors together, last 24 hours

# ───────────── client IP detection ─────────────
# How many reverse proxies append to X-Forwarded-For before a request reaches the backend:
#   2 = caddy + nginx of this compose file (default)
#   3 = one more proxy in front of caddy (e.g. a cloud load balancer)
# With a wrong value all visitors look like one IP and share the MAX_QUESTIONS_PER_IP budget.
TRUSTED_PROXY_COUNT=2

# ───────────── only for the sync job ─────────────
# The folder of the Obsidian vault on THIS machine (mounted read-only into the job)
OBSIDIAN_VAULT_PATH=/Users/you/Documents/Obsidian Vault

# ───────────── rarely needed ─────────────
# CORS_ORIGINS=["https://example.com"]   # only if the API is served from another origin
# VITE_API_BASE=https://api.example.com/api/v1   # build-time; default: /api/v1 (same origin)
# VISION_MODEL=openai/gpt-4o-mini
