# One origin for everything: the static site, /api (the backend) and /media (the photos).

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # The knowledge-base admin API must never be reachable from the internet.
    # The sync job talks to the backend directly, inside the Docker network.
    location ~ ^/api/v1/(index|search)/?$ {
        return 404;
    }

    # The API, including the Server-Sent Events stream of /api/v1/chat/stream.
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # appends the address of the peer that connected to nginx: the backend trusts only the
        # LAST entry (TRUSTED_PROXY_COUNT), what the client wrote on the left is ignored
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # without these the answer would arrive in one piece at the end instead of streaming
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;

        client_max_body_size 64k;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Photos: the file names are content hashes, so they can be cached for a long time.
    location /media/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=604800, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Vite puts a hash into every file name under /assets
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # the single-page app: any other path gets index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
