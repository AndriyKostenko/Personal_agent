  "cards": [
    {
      "dot": "emerald",
      "title": "Answer path",
      "items": [
        "classify sends out-of-scope questions to a fixed refusal, with no tools",
        "agent ⇄ tools loop: search_about_me, find_photos (k=8)",
        "steps, tokens and the answer stream back as SSE events",
        "dialog memory is in-process (InMemorySaver), lost on restart"
      ]
    },
    {
      "dot": "amber",
      "title": "Limits",
      "items": [
        "10 questions and 1 chat per visitor, 15 questions per IP",
        "reserved before the LLM runs, refunded when the agent fails",
        "booking limits are checked by book_call, with the visitor taken from the run config"
      ]
    },
    {
      "dot": "violet",
      "title": "Ingestion",
      "items": [
        "run by hand or the Docker sync job, not by the API",
        "unchanged notes are skipped by MD5 in sync_state.json",
        "indexing endpoints require X-Admin-Key when ADMIN_API_KEY is set"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "legacy /ask_mentor, /index and /search endpoints",
        "Docker deployment: caddy (HTTPS) → nginx → FastAPI"
